{
  "name": "@koolie/tooling",
  "version": "0.8.0",
  "description": "Koolie - Tooling required to build Koolie packages and apps",
  "license": "MIT",
  "author": "David Tymon",
  "type": "module",
  "koolie-module": "tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/dtymon/koolie-tooling"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "koolie",
    "microservices",
    "typescript"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "compile": "tsc",
    "dist": "yarn koolie build-dist -f eslint.config.defaults.mjs eslint.config.mjs eslint.config.spec.mjs jest tsconfig.json tsconfig.spec.json",
    "build": "yarn clean && yarn compile && yarn dist",
    "lint:src": "eslint --config eslint.config.mjs --no-error-on-unmatched-pattern --ignore-pattern 'src/**/*.spec.ts' 'src/**/*.ts'",
    "lint:test": "eslint --config eslint.config.spec.mjs --no-error-on-unmatched-pattern 'src/**/*.spec.ts' 'tests/*.spec.ts' 'tests/**/*.spec.ts'",
    "lint": "yarn lint:src && yarn lint:test",
    "lint:fix:src": "eslint --fix --config eslint.config.mjs --no-error-on-unmatched-pattern --ignore-pattern 'src/**/*.spec.ts' 'src/**/*.ts'",
    "lint:fix:test": "eslint --fix --config eslint.config.spec.mjs --no-error-on-unmatched-pattern 'src/**/*.spec.ts' 'tests/*.spec.ts' 'tests/**/*.spec.ts'",
    "lint:fix": "yarn lint:fix:src && yarn lint:fix:test",
    "test": "NODE_CONFIG_DIR=./etc/config KOOLIE_ENV=test yarn node --experimental-vm-modules $(yarn bin jest) --passWithNoTests",
    "koolie-audit": "yarn run improved-yarn-audit --fail-on-missing-exclusions --ignore-dev-deps --min-severity high",
    "pre-commit": "yarn build && yarn test && yarn lint && yarn koolie-audit",
    "koolie": "node ./dist/koolie",
    "reinstall": "rimraf node_modules yarn.lock; yarn install",
    "release": "yarn build && yarn lint && yarn test && yarn koolie-audit && yarn mkdirp releases && yarn --cwd dist pack --filename releases/koolie-${npm_package_koolie_module}-v${npm_package_version}.tgz",
    "npm-publish": "yarn publish --no-git-tag-version --no-commit-hooks --access public releases/koolie-${npm_package_koolie_module}-v${npm_package_version}.tgz"
  },
  "files": [
    "eslint.config.defaults.mjs",
    "eslint.config.mjs",
    "eslint.config.spec.js",
    "CHANGELOG.md",
    "README.md",
    "jest",
    "tsconfig.json",
    "tsconfig.spec.json",
    "**/*.{ts,js,cjs,mjs,json,pem}",
    "*.map"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli/index.js",
    "./cli/*": "./dist/cli/*.js",
    "./jest/*": "./dist/jest/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "koolie": "./dist/koolie.js",
    "koolie-SubCmdAddPackage.js": "./dist/koolie-SubCmdAddPackage.js",
    "koolie-SubCmdBuildDist.js": "./dist/koolie-SubCmdBuildDist.js",
    "koolie-SubCmdRemovePackage.js": "./dist/koolie-SubCmdRemovePackage.js"
  },
  "dependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/glob-to-regexp": "0.4.4",
    "@types/jest": "30.0.0",
    "@types/jest-when": "3.5.5",
    "@types/klaw": "3.0.7",
    "@types/node": "24.10.9",
    "@types/yargs": "17.0.35",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-tsdoc": "0.5.0",
    "expect-more-jest": "5.5.0",
    "fs-extra": "11.3.3",
    "glob-to-regexp": "0.4.1",
    "improved-yarn-audit": "3.0.4",
    "jest": "30.2.0",
    "jest-junit": "16.0.0",
    "jest-when": "3.7.0",
    "json": "11.0.0",
    "json5": "2.2.3",
    "klaw": "4.1.0",
    "mkdirp": "3.0.1",
    "nodemon": "3.1.11",
    "prettier": "3.8.1",
    "rimraf": "6.1.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "yaml": "2.8.2",
    "yargs": "18.0.0",
    "zod": "4.3.6"
  }
}

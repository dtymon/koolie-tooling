{
  "name": "@koolie/tooling",
  "version": "0.9.0",
  "description": "Koolie - Tooling required to build Koolie packages and apps",
  "license": "MIT",
  "author": "David Tymon",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "koolie": {
    "module": "tooling",
    "subcommands": "./dist/cli/subcommands.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dtymon/koolie-tooling"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "koolie",
    "microservices",
    "typescript"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "compile": "tsc",
    "dist": "yarn koolie build-dist -f eslint.config.defaults.mjs eslint.config.mjs eslint.config.spec.mjs vitest tsconfig.json tsconfig.spec.json",
    "build": "yarn clean && yarn compile && yarn dist",
    "lint:src": "eslint --config eslint.config.mjs --no-error-on-unmatched-pattern --ignore-pattern 'src/**/*.spec.ts' 'src/**/*.ts'",
    "lint:test": "eslint --config eslint.config.spec.mjs --no-error-on-unmatched-pattern 'src/**/*.spec.ts' 'tests/*.spec.ts' 'tests/**/*.spec.ts'",
    "lint": "yarn lint:src && yarn lint:test",
    "lint:fix:src": "eslint --fix --config eslint.config.mjs --no-error-on-unmatched-pattern --ignore-pattern 'src/**/*.spec.ts' 'src/**/*.ts'",
    "lint:fix:test": "eslint --fix --config eslint.config.spec.mjs --no-error-on-unmatched-pattern 'src/**/*.spec.ts' 'tests/*.spec.ts' 'tests/**/*.spec.ts'",
    "lint:fix": "yarn lint:fix:src && yarn lint:fix:test",
    "test": "NODE_CONFIG_DIR=./etc/config KOOLIE_ENV=test vitest run --passWithNoTests",
    "koolie-audit": "audit-ci --config audit-ci.jsonc",
    "pre-commit": "yarn build && yarn test && yarn lint && yarn koolie-audit",
    "koolie": "node ./dist/cli/koolie",
    "reinstall": "rimraf node_modules yarn.lock; yarn install",
    "release": "yarn build && yarn lint && yarn test && yarn koolie-audit && yarn mkdirp releases && yarn --cwd dist pack --filename releases/koolie-${npm_package_koolie_module}-v${npm_package_version}.tgz",
    "npm-publish": "yarn publish --no-git-tag-version --no-commit-hooks --access public releases/koolie-${npm_package_koolie_module}-v${npm_package_version}.tgz"
  },
  "files": [
    "eslint.config.defaults.mjs",
    "eslint.config.mjs",
    "eslint.config.spec.mjs",
    "CHANGELOG.md",
    "README.md",
    "vitest",
    "tsconfig.json",
    "tsconfig.spec.json",
    "**/*.{ts,js,cjs,mjs,json,pem}",
    "*.map"
  ],
  "exports": {
    "./cli/*": "./dist/cli/*.js",
    "./vitest/*": "./dist/vitest/*",
    "./eslint.config.defaults.mjs": "./dist/eslint.config.defaults.mjs",
    "./eslint.config.mjs": "./dist/eslint.config.mjs",
    "./eslint.config.spec.mjs": "./dist/eslint.config.spec.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "koolie": "./dist/cli/koolie.js"
  },
  "dependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/glob-to-regexp": "0.4.4",
    "@types/klaw": "3.0.7",
    "@types/node": "24.13.2",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "4.1.10",
    "audit-ci": "7.1.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-tsdoc": "0.5.2",
    "fs-extra": "11.3.6",
    "glob-to-regexp": "0.4.1",
    "json": "11.0.0",
    "json5": "2.2.3",
    "klaw": "4.1.0",
    "mkdirp": "3.0.1",
    "nodemon": "3.1.14",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "yargs": "18.0.0",
    "zod": "4.4.3"
  },
  "resolutions": {
    "form-data": "4.0.6"
  }
}

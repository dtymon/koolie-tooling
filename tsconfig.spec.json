{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.spec.ts", "tests/*.spec.ts", "tests/**/*.spec.ts"],
  "exclude": ["node_modules", "dist"],

  "compilerOptions": {
    /* Pull in Vitest globals (describe/it/expect/...) and Node ambient types
       so spec files type-check without an explicit `import` per spec. */
    "types": ["vitest/globals", "node"]
  }
}
